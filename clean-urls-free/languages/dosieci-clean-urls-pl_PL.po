#. Plugin Name of the plugin
#: dosieci-clean-urls.php
#: includes/Plugin.php:56
#: includes/Plugin.php:414
msgid "DoSieci Clean URLs"
msgstr "DoSieci Clean URLs"

#. Plugin URI of the plugin
#: dosieci-clean-urls.php
msgid "https://dosieci.pl/wtyczki/clean-urls/"
msgstr "https://dosieci.pl/wtyczki/clean-urls/"

#. Description of the plugin
#: dosieci-clean-urls.php
msgid "Safe URL clean-up for posts, pages and WooCommerce products: a preview of every change, a collision scanner, and 301 redirects without chains or loops. Nothing changes until you approve it."
msgstr "Bezpieczne porządkowanie adresów URL wpisów, stron i produktów WooCommerce: podgląd każdej zmiany, skaner kolizji i przekierowania 301 bez łańcuchów i pętli. Nic się nie zmienia bez Twojej akceptacji."

#. Author of the plugin
#: dosieci-clean-urls.php
msgid "DoSieci"
msgstr "DoSieci"

#. Author URI of the plugin
#: dosieci-clean-urls.php
msgid "https://dosieci.pl/"
msgstr "https://dosieci.pl/"

#: includes/Domain/CollisionScanner.php:52
msgid "The generated slug is empty."
msgstr "Wygenerowany slug jest pusty."

#: includes/Domain/CollisionScanner.php:57
msgid "WordPress reserves this slug."
msgstr "Ten slug jest zarezerwowany przez WordPressa."

#. translators: %d: post ID
#: includes/Domain/CollisionScanner.php:65
msgid "The slug is already used by post #%d."
msgstr "Ten slug jest już używany przez wpis #%d."

#. translators: %d: post ID
#: includes/Domain/CollisionScanner.php:74
msgid "The same slug is also proposed for post #%d."
msgstr "Ten sam slug zaproponowano również dla wpisu #%d."

#: includes/Plugin.php:57
msgid "Clean URLs"
msgstr "Clean URLs"

#: includes/Plugin.php:75
msgid "Preview"
msgstr "Podgląd"

#: includes/Plugin.php:133
msgid "Posts"
msgstr "Wpisy"

#: includes/Plugin.php:134
msgid "Pages"
msgstr "Strony"

#: includes/Plugin.php:138
msgid "Products"
msgstr "Produkty"

#. translators: %s: the slug WordPress would use instead
#: includes/Plugin.php:242
msgid "This address is already taken, WordPress would save it as \"%s\"."
msgstr "Ten adres jest już zajęty — WordPress zapisałby go jako „%s”."

#: includes/Plugin.php:248
msgid "You do not have permission to do this."
msgstr "Nie masz uprawnień do wykonania tej operacji."

#: includes/Plugin.php:394
msgid "You do not have permission to access this page."
msgstr "Nie masz uprawnień do tej strony."

#. translators: %d: number of renamed items
#: includes/Plugin.php:422
msgid "Renamed %d item. Its old address now redirects with a 301."
msgid_plural "Renamed %d items. Their old addresses now redirect with a 301."
msgstr[0] "Zmieniono adres %d elementu. Stary adres przekierowuje teraz kodem 301."
msgstr[1] "Zmieniono adresy %d elementów. Stare adresy przekierowują teraz kodem 301."
msgstr[2] "Zmieniono adresy %d elementów. Stare adresy przekierowują teraz kodem 301."

#. translators: %d: number of skipped items
#: includes/Plugin.php:430
msgid "%d item was skipped because it changed after the preview. Check it again below."
msgid_plural "%d items were skipped because they changed after the preview. Check them again below."
msgstr[0] "%d element pominięto, bo zmienił się po podglądzie. Sprawdź go ponownie poniżej."
msgstr[1] "%d elementy pominięto, bo zmieniły się po podglądzie. Sprawdź je ponownie poniżej."
msgstr[2] "%d elementów pominięto, bo zmieniły się po podglądzie. Sprawdź je ponownie poniżej."

#: includes/Plugin.php:439
msgid "Preview the new addresses before anything changes. Only the rows you tick are renamed, and every old address keeps working through a 301 redirect."
msgstr "Zobacz nowe adresy, zanim cokolwiek się zmieni. Zmieniane są tylko zaznaczone wiersze, a każdy stary adres dalej działa dzięki przekierowaniu 301."

