#. Plugin Name of the plugin
#: dosieci-seo-doctor.php
#: includes/Plugin.php:58
#: includes/Plugin.php:234
msgid "DoSieci SEO Doctor"
msgstr "DoSieci SEO Doctor"

#. Plugin URI of the plugin
#: dosieci-seo-doctor.php
msgid "https://dosieci.pl/wtyczki/seo-doctor/"
msgstr "https://dosieci.pl/wtyczki/seo-doctor/"

#. Description of the plugin
#: dosieci-seo-doctor.php
msgid "A read-only SEO audit of posts, pages and WooCommerce products, with optional AI suggestions for titles and descriptions. Works alongside Yoast SEO, Rank Math, All in One SEO and SEOPress instead of replacing them."
msgstr "Audyt SEO wpisów, stron i produktów WooCommerce wyłącznie do odczytu, z opcjonalnymi podpowiedziami AI dla tytułów i opisów. Współpracuje z Yoast SEO, Rank Math, All in One SEO i SEOPress zamiast je zastępować."

#. Author of the plugin
#: dosieci-seo-doctor.php
msgid "DoSieci"
msgstr "DoSieci"

#. Author URI of the plugin
#: dosieci-seo-doctor.php
msgid "https://dosieci.pl/"
msgstr "https://dosieci.pl/"

#: includes/Adapter/OpenAiClient.php:70
msgid "OpenAI rejected the API key. Check the key in the settings below."
msgstr "OpenAI odrzuciło klucz API. Sprawdź klucz w ustawieniach poniżej."

#: includes/Adapter/OpenAiClient.php:74
msgid "OpenAI does not recognise this model name, or your key has no access to it. Check the model in the settings below."
msgstr "OpenAI nie rozpoznaje tej nazwy modelu albo Twój klucz nie ma do niego dostępu. Sprawdź model w ustawieniach poniżej."

#: includes/Adapter/OpenAiClient.php:78
msgid "OpenAI rate limit or quota reached. Try again in a moment, or check the billing of your OpenAI account."
msgstr "Osiągnięto limit zapytań lub budżetu w OpenAI. Spróbuj ponownie za chwilę albo sprawdź rozliczenia swojego konta OpenAI."

#. translators: %d: HTTP status code
#: includes/Adapter/OpenAiClient.php:84
msgid "OpenAI returned HTTP error %d."
msgstr "OpenAI zwróciło błąd HTTP %d."

#: includes/Adapter/OpenAiClient.php:92
msgid "OpenAI returned an empty answer."
msgstr "OpenAI zwróciło pustą odpowiedź."

#: includes/Domain/SeoAuditor.php:53
msgid "There is no title."
msgstr "Brak tytułu."

#: includes/Domain/SeoAuditor.php:54
msgid "Add a title. Without one, search engines make up their own."
msgstr "Dodaj tytuł — bez niego wyszukiwarka wymyśli własny."

#. translators: %d: number of characters
#: includes/Domain/SeoAuditor.php:63
msgid "The title is %d character long, which is short."
msgid_plural "The title is %d characters long, which is short."
msgstr[0] "Tytuł ma tylko %d znak — to za mało."
msgstr[1] "Tytuł ma tylko %d znaki — to za mało."
msgstr[2] "Tytuł ma tylko %d znaków — to za mało."

#. translators: 1: minimum number of characters, 2: maximum number of characters
#: includes/Domain/SeoAuditor.php:65
msgid "Expand it to %1$d-%2$d characters to use the space in search results."
msgstr "Rozwiń go do %1$d–%2$d znaków, żeby wykorzystać miejsce w wynikach wyszukiwania."

#. translators: %d: number of characters
#: includes/Domain/SeoAuditor.php:74
msgid "The title is %d characters long and will be cut off in search results."
msgstr "Tytuł jest za długi (liczba znaków: %d) i zostanie ucięty w wynikach wyszukiwania."

#. translators: %d: maximum number of characters
#: includes/Domain/SeoAuditor.php:76
#: includes/Domain/SeoAuditor.php:120
msgid "Shorten it to %d characters at most."
msgstr "Skróć go do maksymalnie %d znaków."

#. translators: %d: number of characters
#: includes/Domain/SeoAuditor.php:84
msgid "The title is %d characters long."
msgstr "Liczba znaków w tytule: %d."

#: includes/Domain/SeoAuditor.php:96
msgid "There is no meta description."
msgstr "Brak meta opisu."

#. translators: 1: minimum number of characters, 2: maximum number of characters
#: includes/Domain/SeoAuditor.php:98
msgid "Add a description of %1$d-%2$d characters. Without one, the search engine picks a snippet of the content you have no control over."
msgstr "Dodaj opis o długości %1$d–%2$d znaków. Bez niego wyszukiwarka wybierze fragment treści, na który nie masz wpływu."

#. translators: %d: number of characters
#: includes/Domain/SeoAuditor.php:107
msgid "The meta description is %d character long, which is short."
msgid_plural "The meta description is %d characters long, which is short."
msgstr[0] "Meta opis ma tylko %d znak — to za mało."
msgstr[1] "Meta opis ma tylko %d znaki — to za mało."
msgstr[2] "Meta opis ma tylko %d znaków — to za mało."

#. translators: 1: minimum number of characters, 2: maximum number of characters
#: includes/Domain/SeoAuditor.php:109
msgid "Expand it to %1$d-%2$d characters."
msgstr "Rozwiń go do %1$d–%2$d znaków."

#. translators: %d: number of characters
#: includes/Domain/SeoAuditor.php:118
msgid "The meta description is %d characters long and will be cut off."
msgstr "Meta opis jest za długi (liczba znaków: %d) i zostanie ucięty."

#. translators: %d: number of characters
#: includes/Domain/SeoAuditor.php:128
msgid "The meta description is %d characters long."
msgstr "Liczba znaków w meta opisie: %d."

#. translators: %d: number of words
#: includes/Domain/SeoAuditor.php:136
msgid "The content has about %d word."
msgid_plural "The content has about %d words."
msgstr[0] "Treść ma około %d słowa."
msgstr[1] "Treść ma około %d słów."
msgstr[2] "Treść ma około %d słów."

#. translators: %d: number of words
#: includes/Domain/SeoAuditor.php:144
msgid "Below about %d words, content is often seen as thin. Add real information, not filler."
msgstr "Poniżej ok. %d słów treść bywa oceniana jako uboga. Dodaj konkretne informacje, nie wypełniacz."

#: includes/Domain/SeoAuditor.php:154
msgid "There are no images in the content."
msgstr "W treści nie ma obrazków."

#. translators: 1: number of images without alt text, 2: total number of images
#: includes/Domain/SeoAuditor.php:167
msgid "%1$d of %2$d image has no alternative text."
msgid_plural "%1$d of %2$d images have no alternative text."
msgstr[0] "Bez tekstu alternatywnego: %1$d z %2$d obrazka."
msgstr[1] "Bez tekstu alternatywnego: %1$d z %2$d obrazków."
msgstr[2] "Bez tekstu alternatywnego: %1$d z %2$d obrazków."

#: includes/Domain/SeoAuditor.php:171
msgid "Fill in the alt attribute: it helps both accessibility and image search."
msgstr "Uzupełnij atrybut alt — pomaga zarówno dostępności, jak i wyszukiwarce grafiki."

#. translators: %d: number of images
#: includes/Domain/SeoAuditor.php:178
msgid "%d image has alternative text."
msgid_plural "All %d images have alternative text."
msgstr[0] "%d obrazek ma tekst alternatywny."
msgstr[1] "Wszystkie %d obrazki mają tekst alternatywny."
msgstr[2] "Wszystkich %d obrazków ma tekst alternatywny."

#: includes/Domain/SeoAuditor.php:190
msgid "There is no slug yet."
msgstr "Nie ma jeszcze sluga."

#: includes/Domain/SeoAuditor.php:191
msgid "Set a readable URL before publishing."
msgstr "Ustaw czytelny adres URL przed publikacją."

#. translators: %s: the slug
#: includes/Domain/SeoAuditor.php:200
msgid "The slug \"%s\" is just a number."
msgstr "Slug „%s” to sam numer."

#: includes/Domain/SeoAuditor.php:201
msgid "Use a slug that describes the content: a numeric address tells neither people nor search engines anything."
msgstr "Użyj sluga opisującego treść — numeryczny adres nic nie mówi ani ludziom, ani wyszukiwarkom."

#. translators: %d: number of characters
#: includes/Domain/SeoAuditor.php:210
msgid "The slug is %d characters long."
msgstr "Liczba znaków w slugu: %d."

#: includes/Domain/SeoAuditor.php:211
msgid "Shorten the address: long slugs are harder to share and more often cut off."
msgstr "Skróć adres — długie slugi gorzej się udostępnia i częściej są ucinane."

#. translators: %s: the slug
#: includes/Domain/SeoAuditor.php:219
msgid "The slug \"%s\" looks fine."
msgstr "Slug „%s” wygląda dobrze."

#: includes/Domain/SuggestionPrompt.php:85
msgid "The AI model did not return valid JSON. Try again."
msgstr "Model AI nie zwrócił poprawnego JSON-a. Spróbuj ponownie."

#. translators: %s: name of the missing field
#: includes/Domain/SuggestionPrompt.php:92
msgid "The AI answer is missing the \"%s\" field. Try again."
msgstr "W odpowiedzi AI brakuje pola „%s”. Spróbuj ponownie."

